# OmniWealth environment variables — copy to `.env.local` and fill in.
# NEVER commit `.env.local` (it is gitignored). Only VITE_* vars reach the browser.

# Supabase project (Settings → API). The anon key is safe for client use
# ONLY because Row Level Security is enabled (see schema.sql).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Serverless-only secrets (api/*.ts on Vercel — never prefixed with VITE_,
# so they are never bundled into the browser build).
FINNHUB_API_KEY=
